{
  "manifest_version": 3,
  "name": "ClearPath Ad Shield",
  "version": "1.0.0",
  "description": "Blocks requests to selected advertising and tracking domains and helps prevent common unwanted redirects.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "action": {
    "default_title": "ClearPath Ad Shield",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_and_tracker_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}